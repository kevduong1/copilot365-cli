{
	"name": "@garmin-code-mini/ai",
	"version": "1.3.0",
	"description": "Offline local OpenAI-compatible inference for Garmin Code Mini",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-models": "node scripts/generate-models.ts",
		"build": "tsc -p tsconfig.build.json",
		"build:offline": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@garmin-code-mini/telemetry": "1.3.0",
		"partial-json": "0.1.7",
		"typebox": "1.3.27"
	},
	"keywords": [
		"local",
		"offline",
		"llm",
		"openai-compatible"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}
