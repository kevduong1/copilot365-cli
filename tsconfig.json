{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@gcode/chord": ["./packages/chord/src/index.ts"],
			"@gcode/chord/context": ["./packages/chord/src/context/index.ts"],
			"@gcode/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@gcode/chord/node": ["./packages/chord/src/node.ts"],
			"@gcode/chord/output": ["./packages/chord/src/output.ts"],
			"@gcode/chord/telemetry-sqlite": ["./packages/chord/src/telemetry-sqlite/index.ts"],
			"@gcode/chord/sqlite": ["./packages/chord/src/sqlite/index.ts"],
			"@gcode/chord/sqlite/node": ["./packages/chord/src/sqlite/node.ts"],
			"@gcode/chord/sqlite/cloudflare": ["./packages/chord/src/sqlite/cloudflare.ts"],
			"@gcode/telemetry": ["./packages/telemetry/src/index.ts"],
			"@gcode/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@gcode/telemetry/render": ["./packages/telemetry/src/render.ts"],
			"@gcode/codemode": ["./packages/codemode/src/index.ts"],
			"@gcode/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@gcode/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@gcode/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@gcode/codemode/source": ["./packages/codemode/src/source.ts"],
			"@gcode/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@gcode/mcp": ["./packages/mcp/src/index.ts"],
			"@gcode/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@gcode/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@gcode/ai": ["./packages/ai/src/index.ts"],
			"@gcode/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@gcode/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@gcode/ai/dist/*": ["./packages/ai/src/*"],
			"@gcode/durable": ["./packages/durable/src/index.ts"],
			"@gcode/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@gcode/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@gcode/env": ["./packages/env/src/index.ts"],
			"@gcode/agent-core": ["./packages/agent/src/index.ts"],
			"gcode": ["./packages/coding-agent/src/index.ts"],
			"gcode/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"gcode/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@gcode/tui": ["./packages/tui/src/index.ts"],
			"@gcode/tui/*": ["./packages/tui/src/*"],
			"@gcode/agent-old": ["./packages/agent-old/src/index.ts"],
			"@gcode/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/durable/test-workers/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
